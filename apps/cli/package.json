{
  "name": "@kazi-ai/cli",
  "version": "1.0.0",
  "description": "Primary CLI interface for KaziAI Bench (kazi-bench)",
  "bin": {
    "kazi-bench": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@kazi-ai/core": "workspace:*",
    "@kazi-ai/task-schema": "workspace:*",
    "@kazi-ai/environment-sdk": "workspace:*",
    "@kazi-ai/sandbox": "workspace:*",
    "@kazi-ai/agent-sdk": "workspace:*",
    "@kazi-ai/verifier": "workspace:*",
    "@kazi-ai/metrics": "workspace:*",
    "@kazi-ai/tracing": "workspace:*",
    "@kazi-ai/dataset": "workspace:*",
    "@kazi-ai/reporting": "workspace:*",
    "commander": "^13.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
