# Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://kazi:kazi_secret@localhost:5432/kazi_bench"

# Cache & Queue (Redis)
REDIS_URL="redis://localhost:6379"

# Security & Secrets
JWT_SECRET="development_jwt_secret_must_change_in_production"
KAZI_API_KEY="kazi_live_development_key"

# Agent Sandbox Defaults
SANDBOX_MODE="isolated-process" # or "docker"
MAX_EXECUTION_TIMEOUT_SECONDS=900
MAX_STEPS=100
MAX_TOKENS=100000

# Tracing & Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
LOG_LEVEL="info"
